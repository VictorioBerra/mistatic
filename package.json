{
  "name": "mistatic",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently --names backend,frontend --prefix-colors blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && go run . serve",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "check": "npm --prefix frontend run check",
    "lint": "npm --prefix frontend run lint",
    "format": "npm --prefix frontend run format",
    "test:backend": "cd backend && go test ./...",
    "test:frontend": "npm --prefix frontend run check",
    "test": "npm run test:backend && npm run test:frontend"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "dependencies": {
    "sqlite3": "^6.0.1"
  }
}
